/* SPDX-License-Identifier: GPL-2.0+ */

bootcmd=bootmenu
bootcmd_std=bootflow scan -lb
fastboot_cmd=echo Starting Fastboot...; fastboot usb 0
fastboot_buf_size=0x10000000

bootmenu_title=U-Boot - Google Pixel 7a (lynx)
bootmenu_prompt=Select boot option
bootmenu_delay=-1
bootmenu_default=0
bootmenu_0=Boot from storage=run bootcmd_std
bootmenu_1=Enter Fastboot=run fastboot_cmd
bootmenu_2=U-Boot console=
bootmenu_3=Reboot=reset
bootmenu_4=Power off=poweroff

stdin=serial
stdout=vidconsole
stderr=vidconsole
loadaddr=0x80200000
kernel_addr_r=0x80200000
fdt_addr_r=0x88000000
ramdisk_addr_r=0x8a000000
scriptaddr=0x82000000
pxefile_addr_r=0x82200000
