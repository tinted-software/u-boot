# Exit with error if a local exported symbol is found.
# EXPORT_SYMBOL should be used for global symbols.

import os
import subprocess
import sys

if len(sys.argv) < 2:
    sys.exit(0)

nm = os.environ.get("NM", "nm")
obj = sys.argv[1]

try:
    p = subprocess.run([nm, obj], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, check=True)
except Exception:
    sys.exit(0)

symbol_types = {}
export_symbols = []

for line in p.stdout.splitlines():
    parts = line.split()
    if len(parts) >= 3:
        value, type_char, name = parts[0], parts[1], parts[2]
        symbol_types[name] = type_char
        if name.startswith("__ksymtab_"):
            export_symbols.append(name[len("__ksymtab_"):])

exit_code = 0
for name in export_symbols:
    t = symbol_types.get(name, "")
    if t and t.islower():
        print(f"{obj}: error: local symbol '{name}' was exported", file=sys.stderr)
        exit_code = 1

sys.exit(exit_code)
